{
  "name": "fincontext-mcp",
  "version": "0.1.0",
  "description": "Neutral, self-hosted, open-core MCP server giving an AI agent a consolidated financial picture of a Russian SMB across banks and accounting.",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "main": "src/mcp.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "build": "node scripts/package-functions.js",
    "inspect": "npx @modelcontextprotocol/inspector node scripts/stdio-server.js"
  },
  "keywords": [
    "mcp",
    "fintech",
    "yandex-cloud",
    "reconcile",
    "smb"
  ],
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "functions/**/*.js"
    ]
  }
}
