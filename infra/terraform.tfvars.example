cloud_id  = "b1gxxxxxxxxxxxxxxxxx"
folder_id = "b1gyyyyyyyyyyyyyyyyy"
zone      = "ru-central1-a"

function_name    = "fincontext-mcp"
function_memory  = 256
function_timeout = 30

mcp_zip_path  = "build/mcp.zip"
sync_zip_path = "build/sync.zip"

sync_cron       = "0 */1 * * ? *"
report_currency = "RUB"

tochka_base_url   = "https://enter.tochka.com/sandbox/v2"
moysklad_base_url = ""

lockbox_token_key = "token"

# pro_key = "eyJ...payload.eyJ...signature"

# Лиды с лендинга: хранение в YDB (Document API) + письмо через Postbox.
# Пусто = функция только логирует лид ([LEAD] в Cloud Logging).
# Заведите статический ключ доступа для сервис-аккаунта с правами ydb.editor и Postbox:
#   yc iam access-key create --service-account-name fincontext-mcp-sa
# region           = "ru-central1"
# leads_table      = "leads"
# lead_notify_to   = "you@example.com"
# lead_notify_from = "noreply@yourdomain.ru"   # подтверждённый отправитель Postbox
# yc_static_key_id     = "aje..."
# yc_static_key_secret = "YC...."
